# Copier en .env et adapter. NE PAS versionner .env.
TAX_RATE=0.25
BETA_PERIOD=5y
BETA_FREQUENCY=1wk
MIN_BETA_OBS=24
# Seuil specifique hebdo (24 points hebdo = ~6 mois, trop bruite pour un beta)
MIN_BETA_OBS_WEEKLY=52
# R2 sous ce seuil : beta affiche (en ambre) mais exclu des stats et de la synthese
BETA_MIN_R2=0.10
BASE_CURRENCY=EUR
# Indice unique pour des betas comparables entre pays (ex: ^STOXX). Vide = indice local.
BENCHMARK_UNIQUE=
CACHE_PATH=data/cache.sqlite
# Cache disque des cours yfinance : duree de vie en heures (0 = desactive)
PRICE_CACHE_TTL_HOURS=24
# Base SQLite d'historisation des analyses generees
HISTORY_DB_PATH=data/history.sqlite
# Authentification interne (Step 5) - voir auth_config.example.yaml
AUTH_ENABLED=true
AUTH_CONFIG_PATH=auth_config.yaml
AUTH_COOKIE_NAME=comparables_auth
# Cle de signature du cookie de session : generer avec `python -m comparables.auth genkey`
AUTH_COOKIE_KEY=CHANGE_ME
AUTH_COOKIE_EXPIRY_DAYS=7

# Cles optionnelles pour sources a paliers gratuits (non requises pour Yahoo/EDGAR/Stooq)
FMP_API_KEY=
ALPHAVANTAGE_API_KEY=

# Cache disque des fondamentaux Yahoo (heures, 0 = desactive) + retry
FUNDAMENTALS_CACHE_TTL_HOURS=72
YAHOO_MAX_ATTEMPTS=3
YAHOO_BACKOFF_SECONDS=1.0
# Parallelisme du lot de tickers (borne pour menager les quotas Yahoo)
PIPELINE_MAX_WORKERS=4

# Backend API (lot 1) : origines CORS du front (inutile via le proxy Next, meme origine)
CORS_ORIGINS=http://localhost:3000

# Extraction des comptes annuels INPI (lot 3) - cascade inactive sans ces credentials
# Compte gratuit : data.inpi.fr (acces API comptes annuels)
INPI_USERNAME=
INPI_PASSWORD=
# Garde-fou de debit RNE (le serveur refuse les connexions IP en cas de rafale)
INPI_MIN_INTERVAL_SECONDS=0.5
INPI_MAX_ATTEMPTS=2
INPI_BACKOFF_SECONDS=3.0
# Cle API Claude (etape LLM, dernier recours de la cascade) : platform.claude.com
ANTHROPIC_API_KEY=
# Modele de l'etape LLM (decision cout 2026-06-10 : Haiku ~0,5 ct/document)
CLAUDE_MODEL=claude-haiku-4-5
