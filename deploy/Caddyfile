# Reverse proxy HTTPS (certificat Let's Encrypt automatique).
# Remplacer le domaine par le vôtre (DNS A -> IP du VPS) avant de lancer.
# /api/* va directement à l'API (cookies même origine, pas de CORS) ; le reste au site.

comparables.novances-evaluation.fr {
	handle /api/* {
		reverse_proxy api:8000
	}
	handle {
		reverse_proxy front:3000
	}

	# En-têtes de durcissement (app interne derrière auth applicative).
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
	}
}

# Second site : appli NCFTime (Flask/gunicorn), stack compose séparée sans Caddy.
# « ncftime » est l'alias du conteneur NCFTime sur le réseau partagé « ncf-web ».
time.novances-evaluation.fr {
	reverse_proxy ncftime:8000

	# En-têtes de durcissement (mêmes que le bloc comparables).
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
	}

	# Limite la taille des requêtes (aucune n'a besoin de plus).
	request_body {
		max_size 1MB
	}
}
