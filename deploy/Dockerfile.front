# Site Next.js (frontend/) — build standalone (image légère, serveur node intégré).
# Contexte de build attendu : le dossier frontend/ (cf. deploy/docker-compose.yml).
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
# public/ n'existe pas encore dans le repo (aucun asset statique) : le créer pour la copie finale.
RUN mkdir -p public
# En prod, Caddy route /api directement vers l'API : le proxy Next ne sert qu'en dev.
RUN npm run build

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /app/.next/standalone ./
COPY --from=build /app/.next/static ./.next/static
COPY --from=build /app/public ./public
EXPOSE 3000
CMD ["node", "server.js"]
